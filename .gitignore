# Зависимости ставятся на сборке (npm ci) — в репозиторий не попадают.
node_modules/

# Служебное состояние Supabase CLI.
supabase/.temp/

# Локальные секреты. В репозитории их быть не должно: URL и anon-ключ
# проекта подставляются из переменных репозитория на этапе сборки Pages.
.env
.env.*
config.local.js

# Копия клиента, которую workflow кладёт в сайт (собирается из node_modules).
public/vendor/

# config.js собирает сама Pages из переменных репозитория; локальная копия
# нужна только чтобы запустить сайт у себя: bash tools/serve.mjs
public/config.js
